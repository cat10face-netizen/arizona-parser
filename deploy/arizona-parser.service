[Unit]
Description=Arizona RP parser bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/root/arizona-parser-portable
User=root
Environment=RUST_LOG=info
ExecStart=/root/arizona-parser-portable/arizona-parser
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
StandardOutput=append:/root/arizona-parser-portable/bot.log
StandardError=append:/root/arizona-parser-portable/bot.log

[Install]
WantedBy=multi-user.target
